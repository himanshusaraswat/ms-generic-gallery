# MongoDB Connection Configuration (Option 1: Standard credentials + Host)
DB_USER=your_mongo_user
DB_PASS=your_mongo_password
DB_HOST=cluster0.example.mongodb.net
DB_NAME=generic-gallery

# Or Option 2: Full connection URI
# MONGODB_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/generic-gallery

# Server Configuration
PORT=3000
NODE_ENV=development
